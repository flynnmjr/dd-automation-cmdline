@{
    Tools = @{
        TenableWAS = $true
        SonarQube  = $false
        BurpSuite  = $false
        DefectDojo = $true
        GitHub = @{
            CodeQL         = $true   # Enable GitHub CodeQL SARIF downloads/uploads
            SecretScanning = $false  # Enable GitHub Secret Scanning downloads/uploads
            Dependabot     = $false  # Enable GitHub Dependabot alert downloads/uploads
        }
    }

    # Webhook Notification Settings
    Webhooks = @{
        Enabled       = $false
        Url           = 'https://hooks.slack.com/services/YOUR/WEBHOOK/URL'
        ReportSuccess = $true # Set to $false to only report Failures/Errors
    }

    Paths = @{
        BurpSuiteXmlFolder = 'C:\SecurityScans\BurpSuite\'
    }

    ApiBaseUrls = @{
        TenableWAS = 'https://fedcloud.tenable.com/'
        SonarQube  = 'https://sonarqube.internal.example.com'
        BurpSuite  = 'https://burpsuite.internal.example.com' # Placeholder if API used, or just local path
        DefectDojo = 'https://defect-dojo.internal.example.com/api/v2'
        GitHub     = 'https://api.github.com'
    }

    TenableWASScanId = '0a514d9e-7e2f-4bd5-9e22-e5044e94bc77'

    DefectDojo = @{
        ProductId         = 1
        EngagementId      = 123
        APIScanConfigId   = 1
        TenableWASTestId  = 456
        SonarQubeTestId   = 789
        BurpSuiteTestId   = 101
        GitHubDependabotTestId = 202
        MinimumSeverity   = 'Low'
    }

    GitHub = @{
        Orgs = @('my-org-1', 'my-org-2')
        SkipArchivedRepos = $true
        IncludeRepos = @()
        ExcludeRepos = @()
    }
}
